{
  "type": "api",
  "base_url": "http://localhost:8002/api",
  "formatting_hints": {
    "service_orders": {
      "list_format": "table",
      "columns": ["order_number", "service_type.name", "company.name", "status.name"],
      "column_labels": ["Order # & Type", "Company", "Status"],
      "link_patterns": {
        "order_number": "/service-orders/{id}",
        "details_report_pdf": "/api/service-orders/details-reports/{details_report_id}/pdf/",
        "flash_report_pdf": "/api/service-orders/flash-reports/{flash_report_id}/pdf/"
      }
    },
    "details_reports": {
      "list_format": "detailed",
      "include_fields": ["report_number", "service_order", "observations"],
      "observations_format": "bullet_list_with_status"
    },
    "users": {
      "list_format": "table",
      "columns": ["name", "email", "role", "skills"],
      "filter_display": {"is_active": "Available"}
    },
    "consumables": {
      "list_format": "table",
      "columns": ["name", "current_quantity", "reorder_point", "unit"],
      "status_indicators": {
        "critical": "🔴",
        "low": "🟡",
        "normal": "🟢"
      }
    }
  },
  "resources": {
    "users": {
      "endpoints": [
        {
          "path": "/users/",
          "method": "GET",
          "intent": "read",
          "parameters": {
            "query": ["role", "is_active", "company"]
          }
        },
        {
          "path": "/users/{id}/",
          "method": "GET",
          "intent": "read",
          "parameters": {"path": ["id"]}
        }
      ],
      "fields": ["id", "username", "email", "role", "is_active", "company"]
    },
    "service_orders": {
      "endpoints": [
        {
          "path": "/service-orders/",
          "method": "GET",
          "intent": "read",
          "parameters": {
            "query": ["technician", "status__name", "priority", "company"]
          }
        },
        {
          "path": "/service-orders/{id}/",
          "method": "GET",
          "intent": "read",
          "parameters": {"path": ["id"]}
        }
      ],
      "fields": ["id", "order_number", "technician", "status", "priority", "company", "created_at"]
    },
    "details_reports": {
      "endpoints": [
        {
          "path": "/details-reports/",
          "method": "GET",
          "intent": "read",
          "parameters": {
            "query": ["technician", "ordering", "limit"]
          }
        }
      ],
      "fields": ["id", "report_number", "technician", "observations", "created_at"]
    },
    "consumables": {
      "endpoints": [
        {
          "path": "/inventory/consumables/",
          "method": "GET",
          "intent": "read",
          "parameters": {
            "query": ["stock_level", "category"]
          }
        }
      ],
      "fields": ["id", "name", "current_quantity", "reorder_point", "unit", "category"]
    }
  },
  "resource_hints": {
    "users": {
      "__resource_synonyms__": ["user", "users", "technician", "technicians", "staff", "employees", "people"],
      "role": {
        "values": ["Admin", "Technician", "Customer", "Manager"],
        "synonyms": {
          "technician": "Technician",
          "technicians": "Technician",
          "tech": "Technician",
          "admin": "Admin",
          "administrator": "Admin",
          "customer": "Customer",
          "client": "Customer",
          "manager": "Manager"
        }
      },
      "is_active": {
        "values": [true, false],
        "synonyms": {
          "active": true,
          "available": true,
          "inactive": false,
          "unavailable": false
        }
      }
    },
    "service_orders": {
      "__resource_synonyms__": ["service order", "service orders", "SO", "SOs", "orders", "work orders"],
      "status__name": {
        "values": ["New", "Scheduled", "InProgress", "Completed", "Cancelled"],
        "synonyms": {
          "new": "New",
          "pending": "New",
          "scheduled": "Scheduled",
          "in progress": "InProgress",
          "active": "InProgress",
          "completed": "Completed",
          "done": "Completed",
          "cancelled": "Cancelled"
        }
      },
      "priority": {
        "values": ["Low", "Medium", "High", "Urgent"],
        "synonyms": {
          "low": "Low",
          "medium": "Medium",
          "high": "High",
          "urgent": "Urgent",
          "critical": "Urgent"
        }
      }
    },
    "details_reports": {
      "__resource_synonyms__": ["report", "reports", "detailed report", "detailed reports", "inspection report"],
      "ordering": {
        "values": ["-created_at", "created_at"],
        "synonyms": {
          "latest": "-created_at",
          "newest": "-created_at",
          "recent": "-created_at",
          "last": "-created_at",
          "oldest": "created_at",
          "first": "created_at"
        }
      }
    },
    "consumables": {
      "__resource_synonyms__": ["consumable", "consumables", "inventory", "stock", "items", "materials", "supplies", "parts"],
      "stock_level": {
        "values": ["low", "normal", "high"],
        "synonyms": {
          "low stock": "low",
          "low in stock": "low",
          "low on stock": "low",
          "running low": "low",
          "low": "low",
          "refill": "low",
          "reorder": "low",
          "needs refill": "low",
          "out of stock": "low",
          "empty": "low",
          "normal": "normal",
          "ok": "normal",
          "in stock": "normal",
          "high": "high",
          "overstocked": "high",
          "plenty": "high"
        }
      }
    }
  }
}
