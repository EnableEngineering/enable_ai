{
  "type": "knowledge_graph",
  "version": "1.0.0",
  "domain": "e-commerce",
  "description": "Knowledge graph for e-commerce domain",
  
  "entities": {
    "Person": {
      "description": "Individual person (customer, employee, etc.)",
      "attributes": {
        "name": {"type": "string", "required": true},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "role": {"type": "string", "enum": ["customer", "employee", "manager"]},
        "department": {"type": "string"}
      },
      "aliases": ["Customer", "Employee", "User"]
    },
    
    "Product": {
      "description": "Product or service",
      "attributes": {
        "name": {"type": "string", "required": true},
        "category": {"type": "string"},
        "price": {"type": "number"},
        "sku": {"type": "string"},
        "description": {"type": "text"}
      },
      "aliases": ["Item", "Service"]
    },
    
    "Organization": {
      "description": "Company or business entity",
      "attributes": {
        "name": {"type": "string", "required": true},
        "industry": {"type": "string"},
        "size": {"type": "string"},
        "location": {"type": "string"}
      },
      "aliases": ["Company", "Business"]
    },
    
    "Order": {
      "description": "Purchase transaction",
      "attributes": {
        "order_id": {"type": "string", "required": true},
        "total": {"type": "number"},
        "status": {"type": "string"},
        "date": {"type": "date"}
      },
      "aliases": ["Purchase", "Transaction"]
    }
  },
  
  "relationships": [
    {
      "type": "PURCHASED",
      "from": "Person",
      "to": "Product",
      "description": "Person purchased a product",
      "properties": {
        "date": {"type": "date"},
        "quantity": {"type": "integer"},
        "price": {"type": "number"}
      },
      "aliases": ["BOUGHT", "ORDERED"]
    },
    {
      "type": "WORKS_AT",
      "from": "Person",
      "to": "Organization",
      "description": "Person works at organization",
      "properties": {
        "start_date": {"type": "date"},
        "position": {"type": "string"}
      },
      "aliases": ["EMPLOYED_BY"]
    },
    {
      "type": "SELLS",
      "from": "Organization",
      "to": "Product",
      "description": "Organization sells product",
      "aliases": ["OFFERS", "PROVIDES"]
    },
    {
      "type": "CONTAINS",
      "from": "Order",
      "to": "Product",
      "description": "Order contains product",
      "properties": {
        "quantity": {"type": "integer"},
        "unit_price": {"type": "number"}
      }
    }
  ],
  
  "extraction_rules": {
    "entity_patterns": {
      "Person": [
        {"pattern": "\\b([A-Z][a-z]+ [A-Z][a-z]+)\\b", "attribute": "name"},
        {"pattern": "\\b([a-z0-9._%+-]+@[a-z0-9.-]+\\.[a-z]{2,})\\b", "attribute": "email"}
      ],
      "Product": [
        {"pattern": "product[:\\s]+([^,\\.]+)", "attribute": "name"},
        {"pattern": "\\$([0-9]+\\.?[0-9]*)", "attribute": "price"}
      ]
    },
    "relationship_patterns": {
      "PURCHASED": [
        "(?P<person>\\w+) purchased (?P<product>[^,\\.]+)",
        "(?P<person>\\w+) bought (?P<product>[^,\\.]+)"
      ],
      "WORKS_AT": [
        "(?P<person>\\w+) works at (?P<org>[^,\\.]+)"
      ]
    }
  }
}
