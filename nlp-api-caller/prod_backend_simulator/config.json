{
  "schemas": {
    "api": "schemas/api_schema.json",
    "database": "schemas/database_schema.json",
    "knowledge_graph": "schemas/knowledge_graph.json"
  },
  "client_support": {
    "chatbot": {
      "enabled": true,
      "name": "Natural Language Chatbot",
      "description": "Conversational AI interface for API interactions",
      "features": {
        "natural_language_processing": true,
        "conversation_memory": true,
        "context_persistence": true,
        "entity_extraction": true,
        "intent_classification": true,
        "multi_turn_dialogue": true,
        "follow_up_questions": true,
        "synonym_expansion": true
      },
      "settings": {
        "max_conversation_turns": 10,
        "session_timeout_seconds": 300,
        "auto_clear_context": true,
        "confidence_threshold": 0.6
      },
      "supported_inputs": [
        "text",
        "voice_to_text"
      ],
      "response_format": "conversational"
    },
    "search": {
      "enabled": true,
      "name": "Search Query Interface",
      "description": "Direct search and query interface for API endpoints",
      "features": {
        "keyword_search": true,
        "fuzzy_matching": true,
        "auto_complete": true,
        "spell_check": true,
        "query_suggestions": true,
        "filters": true,
        "sorting": true,
        "pagination": true
      },
      "settings": {
        "max_results": 100,
        "default_page_size": 20,
        "fuzzy_threshold": 0.8,
        "auto_correct_spelling": false
      },
      "supported_inputs": [
        "text",
        "structured_query"
      ],
      "response_format": "structured"
    },
    "api": {
      "enabled": true,
      "name": "Direct API Access",
      "description": "Programmatic API access for integrations",
      "features": {
        "rest_endpoints": true,
        "batch_operations": true,
        "webhooks": false,
        "real_time_updates": false
      },
      "settings": {
        "rate_limiting": true,
        "api_versioning": true,
        "authentication_required": true
      },
      "supported_inputs": [
        "json",
        "xml"
      ],
      "response_format": "json"
    }
  },
  "security_credentials": {
    "api": {
      "jwt": {
        "enabled": true,
        "token_endpoint": "/token/",
        "token_refresh_endpoint": "/token/refresh/",
        "token_verify_endpoint": "/token/verify/",
        "header_format": "Bearer {token}"
      },
      "api_keys": {
        "enabled": false,
        "key_header": "X-API-Key",
        "key_env_variable": "API_KEY"
      },
      "oauth": {
        "enabled": false,
        "client_id_env": "OAUTH_CLIENT_ID",
        "client_secret_env": "OAUTH_CLIENT_SECRET",
        "authorization_url": "",
        "token_url": ""
      }
    },
    "elasticsearch": {
      "basic_auth": {
        "enabled": false,
        "username_env": "ES_USERNAME",
        "password_env": "ES_PASSWORD"
      },
      "ssl": {
        "enabled": false,
        "verify_certs": true,
        "ca_cert_path": ""
      }
    },
    "external_services": {
      "openai": {
        "api_key_env": "OPENAI_API_KEY"
      },
      "pinecone": {
        "api_key_env": "PINECONE_API_KEY"
      }
    }
  },
  "data_sources": {
    "api": {
      "enabled": true,
      "type": "rest_api",
      "base_url": "http://localhost:8002/api",
      "endpoints_spec": "api_spec.json",
      "timeout": 30,
      "retry_attempts": 3,
      "rate_limit": {
        "requests_per_minute": 60,
        "burst": 10
      }
    },
    
    "search_databases": [
      {
        "enabled": false,
        "name": "users_index",
        "type": "elasticsearch",
        "host": "localhost",
        "port": 9200,
        "index": "users",
        "fields_to_search": ["username", "email", "first_name", "last_name"],
        "boost_fields": {
          "username": 2.0,
          "email": 1.5
        }
      },
      {
        "enabled": false,
        "name": "products_index",
        "type": "elasticsearch",
        "host": "localhost",
        "port": 9200,
        "index": "products",
        "fields_to_search": ["name", "description", "sku", "category"],
        "boost_fields": {
          "name": 2.0,
          "sku": 1.8
        }
      }
    ],
    
    "vector_search": {
      "enabled": false,
      "provider": "openai",
      "embedding_model": "text-embedding-3-small",
      "vector_db": {
        "type": "pinecone",
        "api_key_env": "PINECONE_API_KEY",
        "environment": "us-east-1",
        "index_name": "enable-erp-docs",
        "dimension": 1536,
        "metric": "cosine"
      },
      "similarity_threshold": 0.75
    },
    
    "cache": {
      "enabled": false,
      "type": "redis",
      "host": "localhost",
      "port": 6379,
      "ttl": 300,
      "key_prefix": "nlp_api:",
      "cache_queries": true,
      "cache_responses": true
    },
    
    "json_files": {
      "enabled": false,
      "type": "json",
      "file_paths": [
        "data/users.json",
        "data/products.json",
        "data/orders.json"
      ],
      "auto_reload": true,
      "watch_for_changes": false,
      "encoding": "utf-8"
    },
    
    "pdf_documents": {
      "enabled": false,
      "type": "pdf",
      "directory": "documents/",
      "file_patterns": ["*.pdf"],
      "indexing": {
        "enabled": true,
        "extract_text": true,
        "extract_metadata": true,
        "chunk_size": 1000
      },
      "search_type": "text"
    }
  },
  "features": {
    "auto_complete": {
      "enabled": true,
      "min_chars": 3,
      "max_suggestions": 5
    },
    "query_suggestions": {
      "enabled": true,
      "based_on_history": true,
      "popular_queries": true
    },
    "spell_check": {
      "enabled": true,
      "auto_correct": false,
      "suggest_corrections": true
    },
    "multi_language": {
      "enabled": false,
      "supported_languages": ["en"],
      "default_language": "en"
    }
  },
  "security": {
    "rate_limiting": {
      "enabled": true,
      "max_requests_per_ip": 100,
      "time_window_minutes": 15
    },
    "input_sanitization": {
      "enabled": true,
      "block_sql_injection": true,
      "block_xss": true
    },
    "api_key_rotation": {
      "enabled": false,
      "rotation_days": 90
    }
  }
}